  13 -> 20 [id=39, label=<<font point-size="16">Читает и записывает</font><br /><font point-size="11">[SQL / TLS]</font>>, style="solid", color="#444444", fontcolor="#444444"]
  14 -> 21 [id=40, label=<<font point-size="16">Читает и записывает</font><br /><font point-size="11">[SQL / TLS]</font>>, style="solid", color="#444444", fontcolor="#444444"]
  15 -> 22 [id=41, label=<<font point-size="16">Читает и записывает</font><br /><font point-size="11">[SQL / TLS]</font>>, style="solid", color="#444444", fontcolor="#444444"]
  16 -> 23 [id=42, label=<<font point-size="16">Читает и записывает</font><br /><font point-size="11">[SQL / TLS]</font>>, style="solid", color="#444444", fontcolor="#444444"]
